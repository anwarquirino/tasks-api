# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP
PORT=3000

# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Driver de banco: pg (PostgreSQL real) | pglite (em memória, usado nos testes)
DB_DRIVER=pg

# URL de conexão do PostgreSQL (obrigatória quando DB_DRIVER=pg)
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks

# Segredo usado para assinar os JWTs (mínimo de 32 caracteres)
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# Validade do access token (ex.: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Rate limit das rotas de autenticação: janela em ms e máximo de requisições por IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Origens permitidas pelo CORS: * ou lista separada por vírgula
CORS_ORIGIN=*
